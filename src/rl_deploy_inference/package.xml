<?xml version="1.0"?>
<package format="3">
  <name>rl_deploy_inference</name>
  <version>0.1.0</version>
  <description>Real-robot inference node for the iiwa7 cooling-screw insertion RL policy.</description>
  <maintainer email="moreno@example.com">moreno</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>fp_debug_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lbr_fri_idl</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <!-- moveit_msgs is provided by a MoveIt install (ros-humble-moveit); needed only at plan time -->
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pykdl</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
